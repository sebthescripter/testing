local function keyDown(code)
if moveDirs[code] then
heldMove[code] = true
return true
elseif code == K.Space then
startJump()
return true
elseif slotOf[code] then
equipSlot(slotOf[code])
return true
elseif code == K.F9 then
toggleConsole()
return true
elseif code == K.Escape then
toggleMenu()
return true
elseif code == K.Slash then
openChat()
return true
end
return false
end
local function keyUp(code)
if moveDirs[code] then
heldMove[code] = nil
return true
elseif code == K.Space then
stopJump()
return true
elseif slotOf[code] or code == K.F9 or code == K.Escape or code == K.Slash then
return true
end
return false
end
local function sendKey(code, down)
local handled
if down then handled = keyDown(code) else handled = keyUp(code) end
return handled
end
