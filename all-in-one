local function finish()
if not active then return end
active = nil
if sent then
sent = false
sendKey(def.code, false)
end
if not def.mod then setColor(false) end
end
btn.InputBegan:Connect(function(input)
if not isPointer(input) or active then return end
active = input
if kbAddMode then
pinKey(def)
elseif def.mod then
latched = not latched
sendKey(def.code, latched)
setColor(latched)
else
sent = sendKey(def.code, true)
setColor(true)
end
end)
btn.InputEnded:Connect(function(input)
if active and sameInput(active, input) then finish() end
end)
UIS.InputEnded:Connect(function(input)
if active and sameInput(active, input) then finish() end
end)
table.insert(resetters, function()
if latched then
latched = false
sendKey(def.code, false)
setColor(false)
end
end)
end
