table.insert(marquees, { box = box, label = l, start = os.clock() })
return l
end
local marqueeConn = RunService.Heartbeat:Connect(function()
local now = os.clock()
for i = #marquees, 1, -1 do
local m = marquees[i]
if not m.box:IsDescendantOf(gui) then
table.remove(marquees, i)
else
local w = m.box.AbsoluteSize.X
local tw = m.label.TextBounds.X
if tw > w + 1 then
local overflow = tw - w + 4
local pause, speed = 1, 40
local dur = overflow / speed
local total = 2 * (pause + dur)
local t = (now - m.start) % total
local off
if t < pause then
off = 0
elseif t < pause + dur then
off = (t - pause) * speed
elseif t < 2 * pause + dur then
off = overflow
else
off = overflow - (t - 2 * pause - dur) * speed
end
m.label.Size = UDim2.new(0, tw + 4, 1, 0)
m.label.Position = UDim2.new(0, -off, 0, 0)
else
m.label.Size = UDim2.new(1, 0, 1, 0)
m.label.Position = UDim2.new()
end
end
end
end)
