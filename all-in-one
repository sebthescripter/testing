local function snapshot()
local c = lp.Character
if not c then return nil end
local was = c.Archivable
c.Archivable = true
local ok, clone = pcall(function() return c:Clone() end)
c.Archivable = was
if not ok or not clone then return nil end
for _, d in ipairs(clone:GetDescendants()) do
if d:IsA("BasePart") then
d.Anchored = true
d.CanCollide = false
elseif d:IsA("Motor6D") then
d.Transform = CFrame.new()
elseif d:IsA("LuaSourceContainer") then
d:Destroy()
end
end
local hum = clone:FindFirstChildOfClass("Humanoid")
if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
return clone
end
local function frameInfo(model)
local lo, hi, cx, cz
for _, part in ipairs(model:GetChildren()) do
if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
local y1 = part.Position.Y - part.Size.Y / 2
local y2 = part.Position.Y + part.Size.Y / 2
lo = lo and math.min(lo, y1) or y1
hi = hi and math.max(hi, y2) or y2
cx, cz = part.Position.X, part.Position.Z
end
end
if not lo then return Vector3.new(0, 3, 0), 8 end
local root = model:FindFirstChild("HumanoidRootPart")
if root then cx, cz = root.Position.X, root.Position.Z end
return Vector3.new(cx, (lo + hi) / 2, cz), math.clamp((hi - lo) * 1.8, 5, 22)
end
local function rebuild()
if current then
current:Destroy()
current = nil
end
center = nil
local clone = snapshot()
if not clone then
note.Text = "no character yet"
note.Visible = true
return
end
clone.Parent = vp
clone:PivotTo(CFrame.new(0, 0, 0))
center, dist = frameInfo(clone)
current = clone
note.Visible = false
end
task.spawn(function()
task.wait(0.5)
rebuild()
end)
lp.CharacterAdded:Connect(function()
task.wait(2)
if state.alive then rebuild() end
end)
