local marquees = {}
local function marqueeLabel(parentObj, text, size, pos, textSize)
local box = Instance.new("Frame")
box.BackgroundTransparency = 1
box.ClipsDescendants = true
box.Size = size
box.Position = pos
box.Parent = parentObj
local l = label(box, text, UDim2.new(1, 0, 1, 0), UDim2.new(), textSize)
