local function makeDraggable(handle, target, onTap)
local dragging, moved = false, false
local startInput, startPos, startFramePos
handle.InputBegan:Connect(function(input)
if input.UserInputType == Enum.UserInputType.MouseButton1
or input.UserInputType == Enum.UserInputType.Touch then
dragging, moved = true, false
startInput = input
startPos = input.Position
startFramePos = target.Position
end
end)
UIS.InputChanged:Connect(function(input)
if not dragging then return end
local isMove = input.UserInputType == Enum.UserInputType.MouseMovement
or (input.UserInputType == Enum.UserInputType.Touch and input == startInput)
if not isMove then return end
local delta = input.Position - startPos
if not moved and delta.Magnitude > 8 then moved = true end
if moved then
target.Position = UDim2.new(
startFramePos.X.Scale, startFramePos.X.Offset + delta.X,
startFramePos.Y.Scale, startFramePos.Y.Offset + delta.Y
)
end
end)
UIS.InputEnded:Connect(function(input)
if not dragging then return end
if input == startInput
or (input.UserInputType == Enum.UserInputType.MouseButton1 and startInput.UserInputType == Enum.UserInputType.MouseButton1) then
dragging = false
if not moved and onTap then onTap() end
end
end)
end
