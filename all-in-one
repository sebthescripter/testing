local rot = CFrame.fromOrientation(fcPitch, fcYaw, 0)
local look2, right2 = rot.LookVector, rot.RightVector
local h = getHum()
local md = h and h.MoveDirection or Vector3.zero
if fcMode == "camera" and md.Magnitude > 0 then
local flatLook = Vector3.new(look2.X, 0, look2.Z)
local flatRight = Vector3.new(right2.X, 0, right2.Z)
local fwd = flatLook.Magnitude > 0 and md:Dot(flatLook.Unit) or 0
local side = flatRight.Magnitude > 0 and md:Dot(flatRight.Unit) or 0
fcPos = fcPos + (look2 * fwd + right2 * side) * state.freecamVal * dt
end
c2.CFrame = CFrame.new(fcPos) * rot
end)
else
fcBtn.Visible = false
cam.CameraType = Enum.CameraType.Custom
local h = getHum()
if h then cam.CameraSubject = h end
